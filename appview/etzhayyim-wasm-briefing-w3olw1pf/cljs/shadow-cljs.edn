;; etzhayyim-wasm-briefing-w3olw1pf appview — single-page app, single build/module.
;; Mirrors the app-sbom cljs layout (appview + CF Worker static assets).
{:deps {:aliases [:cljs]}
 :builds {:app {:target :browser
                :output-dir "public/js"
                :asset-path "js"
                :modules {:app {:init-fn briefing.desktop/init!}}}}}
